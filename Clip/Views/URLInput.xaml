<UserControl
    x:Class="Clip.Views.URLInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">
    <Border Style="{StaticResource GlassCardBorderStyle}">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="URL" FontWeight="SemiBold" />

            <TextBox Grid.Row="1"
                     Text="{Binding UrlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Paste a video link to analyze automatically, drop a link, or drop a .txt file"
                     MinHeight="46"
                     HorizontalAlignment="Stretch"
                     CornerRadius="12" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{Binding PasteCommand}"
                        ToolTipService.ToolTip="Paste">
                    <SymbolIcon Symbol="Paste" />
                </Button>

                <Button Style="{StaticResource PillButtonStyle}"
                        Command="{Binding ImportLinksCommand}"
                        ToolTipService.ToolTip="Import links from .txt">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" />
                        <TextBlock Text="TXT" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PillButtonStyle}"
                        Command="{Binding QueueDownloadCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Download" />
                        <TextBlock Text="Download" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
